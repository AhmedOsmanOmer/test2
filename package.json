    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "lucide-react": "0.447.0",
    "next": "14.2.35",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
