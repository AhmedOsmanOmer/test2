    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "8.4.47",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
