# قاعدة البيانات
# مع docker-compose: نفس قيمة POSTGRES_PASSWORD
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://gp:<POSTGRES_PASSWORD>@localhost:5432/gp_erp?schema=public"
# مفتاح سري لتوقيع الجلسات (32 حرفاً على الأقل) - أنشئه: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# مجلد تخزين الملفات (خارج public)
STORAGE_DIR="./storage"
# رابط النظام (يستخدم في رموز QR)
APP_URL="http://localhost:3000"
# كلمة مرور المدير الأولية للـ seed فقط (10 أحرف على الأقل، حروف وأرقام) — اختر قيمة عشوائية خاصة بك
SEED_ADMIN_PASSWORD=""
# مفتاح المهام الدورية (24 حرفًا على الأقل)
CRON_SECRET="change-me-cron-secret-at-least-24-chars"
